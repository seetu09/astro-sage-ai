# ─────────────────────────────────────────────────────────────────────────────
# AstroVeda — required environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env*` except this
# template. Internal secrets (Supabase anon key, Razorpay, Gemini)
# ADMIN_PASSWORD) are exposed to the server only.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (client auth + kundali chart cache + avatar storage)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-side wallet enforcement (Phase 4) — service-role key bypasses RLS.
# SERVER ONLY: never expose via NEXT_PUBLIC_. Required by /api/wallet,
# /api/chat (credit debit), and /api/payment/verify (top-up credit).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Razorpay payments (server: create-order + verify; client needs key id)
RAZORPAY_KEY_ID=<rzp_live_...>
RAZORPAY_KEY_SECRET=<secret>
NEXT_PUBLIC_RAZORPAY_KEY_ID=<rzp_live_...>
# Used to sign & verify payment-unlock tokens for paid reports (defaults to
# RAZORPAY_KEY_SECRET if unset).
PAYMENT_UNLOCK_SECRET=<long-random-string>

# AI providers
GEMINI_API_KEY=<gemini-key>                          # chat + kundali pillar narratives

# Admin blog publishing + admin session gate (server-only secrets).
# ADMIN_PASSWORD is the login credential verified by /api/admin/login.
# ADMIN_SESSION_TOKEN is the opaque value of the httpOnly `admin_session`
# cookie set on success and checked by middleware.ts. Generate with:
#   openssl rand -hex 32
# Changing the token logs every existing admin session out.
ADMIN_PASSWORD=<change-me>
ADMIN_SESSION_TOKEN=<openssl-rand-hex-32>

# Local-only diagnostics for a personal app/api/debug route (gitignored, not
# deployed). Requires this value in an `x-debug-secret` header.
# Generate with: openssl rand -hex 32
DEBUG_SECRET=<local-dev-debug-secret>

# Public app origin (used as OAuth redirect base)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps (test key commented out intentionally — ALWAYS restrict by HTTP
# referrer in Google Cloud Console before going live)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<maps-key>
GOOGLE_MAPS_API_KEY=<maps-key>

# Optional: Google Analytics. No-op when unset.
NEXT_PUBLIC_GA_ID=

# Optional: Upstash Redis for distributed rate limiting (lib/rateLimit.ts).
# When BOTH are set the limiter uses Upstash (a shared sliding window across
# serverless instances). When either is absent — local dev, CI, offline tests —
# the app falls back to the in-memory limiter automatically. A Redis error at
# runtime also falls back rather than failing the request.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=