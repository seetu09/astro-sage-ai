# ─────────────────────────────────────────────────────────────────────────────
# AstroVeda — required environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env*` except this
# template. Internal secrets (Supabase anon key, Razorpay, Gemini/Moonshot,
# ADMIN_PASSWORD) are exposed to the server only.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (client auth + kundali chart cache + avatar storage)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Razorpay payments (server: create-order + verify; client needs key id)
RAZORPAY_KEY_ID=<rzp_live_...>
RAZORPAY_KEY_SECRET=<secret>
NEXT_PUBLIC_RAZORPAY_KEY_ID=<rzp_live_...>
# Used to sign & verify payment-unlock tokens for paid reports (defaults to
# RAZORPAY_KEY_SECRET if unset).
PAYMENT_UNLOCK_SECRET=<long-random-string>

# AI providers
GEMINI_API_KEY=<gemini-key>                          # chat + kundali pillar narratives
MOONSHOT_API_KEY=<moonshot-key>                      # horoscope + tarot interpretation

# Admin blog publishing (shared secret passed in the admin form)
ADMIN_PASSWORD=<change-me>

# Public app origin (used as OAuth redirect base)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps (test key commented out intentionally — ALWAYS restrict by HTTP
# referrer in Google Cloud Console before going live)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<maps-key>
GOOGLE_MAPS_API_KEY=<maps-key>

# Optional: Google Analytics. No-op when unset.
NEXT_PUBLIC_GA_ID=